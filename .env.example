# ──────────────────────────────────────────────────────────────
# Alita Pricelist — Environment Variables
# ──────────────────────────────────────────────────────────────
# Setup (disarankan):
#   1. cp .env.example .env.staging
#   2. cp .env.example .env.production
#   3. Isi secrets di keduanya; bedakan hanya APP_ENV + API_BASE_URL
#   4. ./scripts/use-env.sh staging     → aktifkan untuk `flutter run`
#   5. ./scripts/release.sh android     → SELALU baca .env.production (default)
#
# JANGAN commit `.env`, `.env.staging`, atau `.env.production`.
#
# SETUP FIREBASE (required after fresh clone):
#   1. Install FlutterFire CLI:  dart pub global activate flutterfire_cli
#   2. Run:  flutterfire configure
#      This generates: lib/firebase_options.dart,
#      android/app/google-services.json, ios/Runner/GoogleService-Info.plist
# ──────────────────────────────────────────────────────────────

# staging | production — harus cocok dengan API_BASE_URL
APP_ENV=staging

# Alita (Ruby) API
# staging:    https://staging.alitav2.massindo.com/api
# production: https://alitav2.massindo.com/api
API_BASE_URL=https://staging.alitav2.massindo.com/api

# Opsional: override path Paper (default: paper_id_staging | payper_id dari APP_ENV)
# PAPER_PAYMENT_PATH=payper_id

# OAuth client credentials — WAJIB keduanya terisi untuk platform yang Anda jalankan.
# AppConfig memilih pasangan berdasarkan OS: Android vs iOS memakai key BERBEDA.
# Jika hanya CLIENT_ID_ANDROID yang diisi, build iOS/Simulator akan gagal "konfigurasi tidak lengkap".

# Android (flutter run -d android / APK)
CLIENT_ID_ANDROID=your_android_client_id
CLIENT_SECRET_ANDROID=your_android_client_secret

# iOS (flutter run -d ios / Xcode) — harus terisi tersendiri, bukan menyalin dari Android kecuali backend mengizinkan sama
CLIENT_ID_IOS=your_ios_client_id
CLIENT_SECRET_IOS=your_ios_client_secret

# Comforta API (Brand Spec)
COMFORTA_API_HOST=comforta.co.id
COMFORTA_ACCESS_TOKEN=your_comforta_access_token
COMFORTA_CLIENT_ID=your_comforta_client_id
COMFORTA_CLIENT_SECRET=your_comforta_client_secret

# Spring Air API (Brand Spec)
SPRINGAIR_API_HOST=springair.co.id
SPRINGAIR_ACCESS_TOKEN=your_springair_access_token
SPRINGAIR_CLIENT_ID=your_springair_client_id
SPRINGAIR_CLIENT_SECRET=your_springair_client_secret

# Therapedic API (Brand Spec)
THERAPEDIC_API_HOST=therapedic.co.id
THERAPEDIC_ACCESS_TOKEN=your_therapedic_access_token
THERAPEDIC_CLIENT_ID=your_therapedic_client_id
THERAPEDIC_CLIENT_SECRET=your_therapedic_client_secret

# iSleep API (Brand Spec)
ISLEEP_API_HOST=isleep.co.id
ISLEEP_ACCESS_TOKEN=your_isleep_access_token
ISLEEP_CLIENT_ID=your_isleep_client_id
ISLEEP_CLIENT_SECRET=your_isleep_client_secret

# Region API (Indonesian Administrative Data)
REGION_API_BASE_URL=https://geo.velrox.cloud

# Indirect / toko assign (daftar toko per sales code — host terpisah dari Alita API)
# Wajib ketiganya agar mode indirect bisa memuat daftar toko.
INDIRECT_STORES_BASE_URL=https://your-indirect-stores-host.example
INDIRECT_API_KEY=your_indirect_x_api_key
INDIRECT_CLIENT_KEY=your_indirect_x_client_key

# Firebase Configuration (for Cloud Functions / Admin SDK)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
